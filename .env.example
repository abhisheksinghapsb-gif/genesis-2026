# GENESIS 2026 Environment Configuration

# Backend Master Switch: 'off' (default) keeps the site strictly static without backend calls.
# Set to 'on' when Cloudflare Pages Functions / D1 database are deployed.
NEXT_PUBLIC_BACKEND=off

# Site Canonical URL
NEXT_PUBLIC_SITE_URL=https://genesis2026.aitpune.edu.in

# Registration Form URL (fallback when backend is off)
NEXT_PUBLIC_REGISTRATION_URL=

# Cloudflare Turnstile Site Key (public, required when NEXT_PUBLIC_BACKEND=on)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

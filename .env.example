# ==============================================================================
# GENESIS 2026 - Environment Variables Configuration
# Copy this file to .env.local for local development.
# ==============================================================================

# ------------------------------------------------------------------------------
# App Environment
# ------------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# ------------------------------------------------------------------------------
# Database Access Layer
# Options for DB_ADAPTER: "memory" (default for dev/test) | "supabase" (production)
# ------------------------------------------------------------------------------
DB_ADAPTER=memory
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Tournament Admin Authentication
# ------------------------------------------------------------------------------
ADMIN_SECRET=genesis-secret-admin-key

# ------------------------------------------------------------------------------
# Email Confirmations (Resend)
# If RESEND_API_KEY is unset or placeholder, MockEmailProvider logs to console.
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_123456789
EMAIL_FROM="GENESIS 2026 <no-reply@genesis-gdxr.com>"

# ------------------------------------------------------------------------------
# Cloudflare Turnstile Bot Protection
# Test keys (always pass):
# Sitekey: 1x00000000000000000000AA
# Secret:  1x0000000000000000000000000000000AA
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# ------------------------------------------------------------------------------
# Rate Limiting (Upstash Redis with in-memory fallback)
# If left blank, local sliding-window in-memory limiter is active.
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
